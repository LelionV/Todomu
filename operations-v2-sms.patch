+{% block extra_js %}
+<script>
+(function () {
+  const hostSel = document.querySelector('select[name="host_user"]');
+  const deptSel = document.querySelector('select[name="host_department"]');
+  const phone   = document.querySelector('input[name="host_phone"]');
+  const nameEl  = document.getElementById('sms-host-name');
+  const roleEl  = document.getElementById('sms-host-role');
+  const hintEl  = document.getElementById('sms-phone-hint');
+  if (!hostSel || !deptSel || !phone) return;
+  const keepTyped = phone.value !== '';   // re-shown after a validation error
+  let first = true;
+
+  function lookup() {
+    const qs = new URLSearchParams({ host_user: hostSel.value, host_department: deptSel.value });
+    fetch('{% url "visitors:host_lookup" %}?' + qs.toString(), { credentials: 'same-origin' })
+      .then(r => r.json())
+      .then(d => {
+        if (d.no_department) {
+          nameEl.textContent = 'Select a host or a department';
+          roleEl.textContent = 'You are not assigned to a department.';
+        } else {
+          nameEl.textContent = d.name || '—';
+          roleEl.textContent = d.role + (d.auto_department ? ' (your department, auto-selected)' : '');
+        }
+        if (!(first && keepTyped)) phone.value = d.phone || '';
+        hintEl.textContent = d.phone
+          ? 'Saved number pre-filled. Change it here to update the host’s profile.'
+          : 'No number saved for this host yet. Enter it once; it will be remembered.';
+        hintEl.style.color = d.phone ? '' : 'var(--warning)';
+        first = false;
+      })
+      .catch(() => {});
+  }
+  hostSel.addEventListener('change', lookup);
+  deptSel.addEventListener('change', lookup);
+  lookup();
+})();
+</script>
+{% endblock %}
