index 0000000..f210c7f
--- /dev/null
+++ b/apps/visitors/sms.py
@@ -0,0 +1,153 @@
+"""
+Talksasa BulkSMS (API v3) client.
+
+    POST {endpoint}/sms/send
+    Authorization: Bearer <API token>
+    {"recipient": "2547XXXXXXXX", "sender_id": "...", "type": "plain", "message": "..."}
+
+Configuration is read from System → SMS Settings (SystemSetting rows) and falls
+back to these environment variables (.env):
+
+    TALKSASA_API_URL     default https://bulksms.talksasa.com/api/v3/
+    TALKSASA_API_TOKEN   your API token, e.g. 4842|xxxxxxxx
+    TALKSASA_SENDER_ID   your approved sender ID
+
+Uses only the Python standard library, so no extra package is required.
+"""
+import json
+import logging
+import re
+import socket
+import urllib.error
+import urllib.request
+
+log = logging.getLogger(__name__)
+
+DEFAULT_ENDPOINT = 'https://bulksms.talksasa.com/api/v3/'
+DEFAULT_SENDER_ID = 'TALK-SASA'
+TIMEOUT_SECONDS = 15
+
+
+# ── Phone numbers ────────────────────────────────────────────────────────────
+
+def normalize_phone(raw):
+    """
+    Return a Kenyan mobile number as 2547XXXXXXXX / 2541XXXXXXXX (the format
+    Talksasa expects, no '+'), or '' if it is not a valid Kenyan mobile number.
+
+    Accepts: 0712345678, 712345678, +254712345678, 254 712 345 678, 0112345678 …
+    """
+    digits = re.sub(r'\D', '', str(raw or ''))
+    if digits.startswith('254') and len(digits) == 12:
+        pass
+    elif digits.startswith('0') and len(digits) == 10:
+        digits = '254' + digits[1:]
+    elif len(digits) == 9:
+        digits = '254' + digits
+    else:
+        return ''
+    if digits[3] not in '17':          # Kenyan mobile ranges are 07xx and 01xx
+        return ''
+    return digits
+
+
+def display_phone(raw):
+    """+2547XXXXXXXX for storing on the user profile and showing on screen."""
+    n = normalize_phone(raw)
+    return f'+{n}' if n else ''
+
+
+def mask_phone(raw):
+    n = normalize_phone(raw)
+    return f'+{n[:6]}***{n[-3:]}' if n else ''
+
+
+# ── Configuration ────────────────────────────────────────────────────────────
+
+def get_config():
+    from apps.settings_manager.models import SystemSetting
+    return SystemSetting.get_sms_config()
+
+
+def is_configured(cfg=None):
+    cfg = cfg or get_config()
+    return bool(cfg['enabled'] and cfg['token'])
+
+
+# ── Sending ──────────────────────────────────────────────────────────────────
+
+def _error_text(body, fallback):
+    try:
+        data = json.loads(body)
+        msg = data.get('message') or data.get('error') or data.get('errors')
+        if isinstance(msg, (dict, list)):
+            msg = json.dumps(msg)
+        return str(msg) if msg else fallback
+    except Exception:
+        return (body or fallback)[:200]
+
+
+def send_sms(phone, message, cfg=None):
+    """
+    Send one SMS. Never raises.
+    Returns (ok: bool, detail: str) — detail is shown to the user / logged.
+    """
+    cfg = cfg or get_config()
+    if not cfg['enabled']:
+        return False, 'SMS is disabled in System → SMS Settings.'
+    if not cfg['token']:
+        return False, 'Talksasa API token is not set in System → SMS Settings.'
+
+    recipient = normalize_phone(phone)
+    if not recipient:
+        return False, f'"{phone}" is not a valid Kenyan mobile number.'
+
+    url = cfg['endpoint'].rstrip('/') + '/sms/send'
+    payload = {
+        'recipient': recipient,
+        'sender_id': cfg['sender_id'] or DEFAULT_SENDER_ID,
+        'type': 'plain',
+        'message': message,
+    }
+    req = urllib.request.Request(
+        url,
+        data=json.dumps(payload).encode('utf-8'),
+        method='POST',
+        headers={
+            'Authorization': f"Bearer {cfg['token']}",
+            'Content-Type': 'application/json',
+            'Accept': 'application/json',
+        },
+    )
+    try:
+        with urllib.request.urlopen(req, timeout=TIMEOUT_SECONDS) as resp:
+            body = resp.read().decode('utf-8', 'replace')
+    except urllib.error.HTTPError as e:
+        body = e.read().decode('utf-8', 'replace')
+        detail = f'Talksasa HTTP {e.code}: {_error_text(body, e.reason)}'
+        log.warning('SMS to %s failed: %s', mask_phone(recipient), detail)
+        return False, detail
+    except (urllib.error.URLError, socket.timeout, OSError) as e:
+        detail = f'Could not reach Talksasa: {getattr(e, "reason", e)}'
+        log.warning('SMS to %s failed: %s', mask_phone(recipient), detail)
+        return False, detail
+
+    try:
+        data = json.loads(body)
+    except ValueError:
+        log.warning('SMS to %s: non-JSON response: %s', mask_phone(recipient), body[:200])
+        return False, 'Talksasa returned an unexpected response.'
+
+    status = data.get('status')
+    failed = (
+        status is False
+        or (isinstance(status, str) and status.lower() in ('error', 'failed', 'fail'))
+        or data.get('success') is False
+    )
+    if failed:
+        detail = f'Talksasa rejected the SMS: {_error_text(body, "unknown error")}'
+        log.warning('SMS to %s failed: %s', mask_phone(recipient), detail)
+        return False, detail
+
+    log.info('SMS sent to %s', mask_phone(recipient))
+    return True, f'SMS sent to {mask_phone(recipient)}.'
