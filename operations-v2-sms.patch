+        'no_department': auto and not department,
+    })
+
+
+@login_required
+def save_my_phone(request):
+    """Save the signed-in user's own mobile number (used for visitor SMS)."""
+    if request.method == 'POST':
+        form = MyPhoneForm(request.POST)
+        if form.is_valid():
+            request.user.phone = form.cleaned_data['phone']
+            request.user.save(update_fields=['phone'])
+            messages.success(request, f'Your mobile number {request.user.phone} has been saved.')
+        else:
+            messages.error(request, form.errors['phone'][0])
+    return redirect(reverse('visitors:dashboard'))
+
