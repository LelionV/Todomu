@@ -140,6 +140,26 @@ class VisitorAppointment(models.Model):
     def is_today(self):
         return self.scheduled_date == timezone.now().date()
 
+    # ── Host resolution (who receives the SMS) ─────────────────────────────
+    @staticmethod
+    def find_host(host_user=None, host_department=None, booked_by=None):
+        """
+        The person notified about this visit:
+          1. the selected host staff member, else
+          2. the HOD of the selected (or auto-picked) department, else
+          3. the person who booked the appointment.
+        """
+        if host_user:
+            return host_user
+        if host_department:
+            hod = host_department.get_hod()
+            if hod:
+                return hod
+        return booked_by
+
+    def resolve_host(self):
+        return self.find_host(self.host_user, self.host_department, self.booked_by)
+
 
