+{% extends 'base.html' %}
+{% load settings_tags %}
+{% block title %}SMS Settings{% endblock %}
+{% block topbar_title %}SMS Settings{% endblock %}
+
+{% block content %}
+<div style="max-width:760px">
+
+  <div class="card mb-16">
+    <div class="card-header">
+      <span class="card-title"><i class="bi bi-chat-dots" style="margin-right:8px;color:var(--brand)"></i>Talksasa BulkSMS</span>
+      {% if sms_config.enabled and sms_config.token %}
+        <span class="badge badge-approved"><i class="bi bi-check-circle"></i> Active</span>
+      {% elif sms_config.enabled %}
+        <span class="badge badge-warning">Enabled — token missing</span>
+      {% else %}
+        <span class="badge badge-cancelled">Disabled</span>
+      {% endif %}
+    </div>
+    <div class="card-body">
+      <p class="text-muted fs-13 mb-16">
+        Visitor notifications are sent by SMS to the <strong>host only</strong>: when a visit is booked,
+        when the visitor is checked in at the gate, and when a visit is cancelled.
+        Changes take effect immediately.
+      </p>
+
+      <form method="post">
+        {% csrf_token %}
+
+        <div class="card mb-16" style="border-color:var(--brand-light);background:var(--brand-light)">
+          <div class="card-body" style="padding:14px 18px">
+            <div class="d-flex align-center justify-between">
+              <div>
+                <div class="fw-600 fs-13">Enable SMS Notifications</div>
+                <div class="text-muted fs-12">Keep disabled while you set up, then enable and send a test.</div>
+              </div>
+              {% with s=field_map|get_item:'sms_enabled' %}
+              <select name="sms_enabled" class="form-select" style="width:auto">
+                <option value="false" {% if not s or s.value != 'true' %}selected{% endif %}>Disabled</option>
+                <option value="true"  {% if s and s.value == 'true' %}selected{% endif %}>Enabled</option>
+              </select>
+              {% endwith %}
+            </div>
+          </div>
+        </div>
+
+        <div class="grid grid-2" style="gap:16px;margin-bottom:16px">
+          <div style="grid-column:span 2" class="form-group">
+            <label class="form-label">API Endpoint (OAuth 2.0)</label>
+            {% with s=field_map|get_item:'sms_api_url' %}
+            <input type="url" name="sms_api_url" class="form-control"
+                   value="{{ s.value|default:'https://bulksms.talksasa.com/api/v3/' }}"
+                   placeholder="https://bulksms.talksasa.com/api/v3/">
+            {% endwith %}
+            <div class="form-hint">Messages are posted to <code>&lt;endpoint&gt;sms/send</code>.</div>
+          </div>
+
+          <div class="form-group">
+            <label class="form-label">API Token</label>
+            <input type="password" name="sms_api_token" class="form-control"
+                   placeholder="{% if token_saved %}Saved ({{ token_hint }}) — leave blank to keep{% else %}Paste token, e.g. 4842|xxxxxxxx{% endif %}"
+                   autocomplete="new-password">
+            {% if token_from_env %}
+              <div class="form-hint">Currently using TALKSASA_API_TOKEN from the server's .env file.</div>
+            {% elif token_saved %}
+              <label class="fs-12 text-muted" style="display:flex;gap:6px;align-items:center;margin-top:6px">
+                <input type="checkbox" name="sms_api_token_clear" value="1"> Remove the saved token
+              </label>
+            {% else %}
+              <div class="form-hint">Sent as <code>Authorization: Bearer &lt;token&gt;</code>. Never share it by email or chat.</div>
+            {% endif %}
+          </div>
+
+          <div class="form-group">
+            <label class="form-label">Sender ID</label>
+            {% with s=field_map|get_item:'sms_sender_id' %}
+            <input type="text" name="sms_sender_id" class="form-control" maxlength="11"
+                   value="{{ s.value|default:'' }}" placeholder="e.g. TALK-SASA">
+            {% endwith %}
+            <div class="form-hint">The approved sender name on your Talksasa account (max 11 characters).</div>
+          </div>
+        </div>
+
+        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Settings</button>
+      </form>
+    </div>
+  </div>
+
+  <div class="card mb-16">
+    <div class="card-header"><span class="card-title"><i class="bi bi-send" style="margin-right:6px"></i>Send Test SMS</span></div>
+    <div class="card-body">
+      <p class="text-muted fs-13 mb-16">Send a test message to confirm the token and sender ID work. SMS must be <strong>enabled</strong> above first.</p>
+      <form method="post" action="{% url 'settings_manager:test_sms' %}">
+        {% csrf_token %}
+        <div class="d-flex gap-12 align-center">
+          <div style="flex:1;max-width:320px">
+            <input type="text" name="test_sms_to" class="form-control" placeholder="0712345678" inputmode="tel" required>
+          </div>
+          <button type="submit" class="btn btn-outline"><i class="bi bi-send"></i> Send Test</button>
+        </div>
+      </form>
+    </div>
+  </div>
+
+  <div class="card" style="background:#f8fafc">
+    <div class="card-body fs-12 text-muted">
+      <div class="fw-600 mb-4" style="color:var(--text)"><i class="bi bi-lightbulb" style="margin-right:4px"></i>Mobile numbers</div>
+      Hosts' numbers are stored on their user profile. Users can save their own number on the Visitor Dashboard,
+      and whoever books a visit can enter or update the host's number on the booking form; it is then reused
+      until someone changes it. Numbers are accepted as 0712345678, 712345678 or +254712345678.
+    </div>
+  </div>
+</div>
+{% endblock %}
