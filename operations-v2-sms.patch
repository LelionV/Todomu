     return redirect(reverse_lazy('settings_manager:email'))
+
+
+# ── SMS (Talksasa BulkSMS) ────────────────────────────────────────────────────
+
+SMS_FIELDS = [
+    {'key': 'sms_enabled',   'label': 'Enable SMS Notifications',
+     'description': 'Turn on/off visitor SMS notifications to hosts.',
+     'is_password': False},
+    {'key': 'sms_api_url',   'label': 'Talksasa API Endpoint',
+     'description': 'Talksasa OAuth 2.0 API endpoint (v3).',
+     'is_password': False},
+    {'key': 'sms_api_token', 'label': 'Talksasa API Token',
+     'description': 'Bearer token from your Talksasa account (Developers → API token).',
+     'is_password': True},
+    {'key': 'sms_sender_id', 'label': 'Sender ID',
+     'description': 'Your approved sender ID (max 11 characters).',
+     'is_password': False},
+]
+
+
+def _seed_sms_settings():
+    import os
+    defaults = {
+        'sms_enabled':   'false',
+        'sms_api_url':   os.environ.get('TALKSASA_API_URL', 'https://bulksms.talksasa.com/api/v3/'),
+        'sms_api_token': '',
+        'sms_sender_id': os.environ.get('TALKSASA_SENDER_ID', ''),
+    }
+    for field in SMS_FIELDS:
+        SystemSetting.objects.get_or_create(
+            key=field['key'],
+            defaults={
+                'label':       field['label'],
+                'description': field['description'],
+                'is_password': field['is_password'],
+                'value':       defaults.get(field['key'], ''),
+            }
+        )
+
+
+class SMSSettingsView(StaffRequiredMixin, TemplateView):
+    template_name = 'settings_manager/sms.html'
+
+    def get(self, request, *args, **kwargs):
+        _seed_sms_settings()
+        return super().get(request, *args, **kwargs)
+
+    def get_context_data(self, **kwargs):
+        import os
+        ctx = super().get_context_data(**kwargs)
+        settings_qs = SystemSetting.objects.filter(key__startswith='sms_')
+        ctx['field_map'] = {s.key: s for s in settings_qs}
+        token = ctx['field_map'].get('sms_api_token')
+        ctx['token_saved'] = bool(token and token.value)
+        ctx['token_from_env'] = not ctx['token_saved'] and bool(os.environ.get('TALKSASA_API_TOKEN'))
+        ctx['token_hint'] = (token.value.split('|')[0] + '|••••••') if ctx['token_saved'] and '|' in token.value \
+            else ('••••••' if ctx['token_saved'] else '')
+        ctx['sms_config'] = SystemSetting.get_sms_config()
+        return ctx
+
+    def post(self, request, *args, **kwargs):
+        _seed_sms_settings()
+        for field in SMS_FIELDS:
+            key = field['key']
+            val = request.POST.get(key, '').strip()
+            setting = SystemSetting.objects.get(key=key)
+            if field['is_password']:
+                if request.POST.get('sms_api_token_clear'):
+                    val = ''
+                elif not val:
+                    continue  # keep the existing token
+            if key == 'sms_sender_id':
+                val = val[:11]
+            setting.value = val
+            setting.label = field['label']
+            setting.description = field['description']
+            setting.is_password = field['is_password']
+            setting.save()
+        messages.success(request, 'SMS settings saved.')
+        return redirect(reverse_lazy('settings_manager:sms'))
+
+
+@login_required
+def test_sms(request):
+    if not request.user.is_staff:
+        messages.error(request, 'Staff only.')
+        return redirect('/')
+    if request.method == 'POST':
+        from apps.visitors.sms import send_sms
+        to = request.POST.get('test_sms_to', '').strip()
+        if not to:
+            messages.error(request, 'Enter a mobile number.')
+        else:
+            ok, detail = send_sms(to, 'Test SMS from Operations Suite. Your Talksasa settings are working.')
+            (messages.success if ok else messages.error)(request, detail)
+    return redirect(reverse_lazy('settings_manager:sms'))
